# Copy to .env.local (local dev) or paste into Vercel's environment variables.
# Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # "anon / public" (may be labelled "publishable")
SUPABASE_SERVICE_ROLE_KEY=              # "service_role" (may be labelled "secret") — never NEXT_PUBLIC_
NEXT_PUBLIC_APP_URL=http://localhost:3000   # your real domain once deployed

# Optional. The app runs fully without these — see README.
RESEND_API_KEY=
EMAIL_FROM="IQ Sports Supply <orders@iqsportssupply.com>"
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/api/xero/callback

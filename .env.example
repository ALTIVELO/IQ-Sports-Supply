# ── Required from phase 1 ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional until phase 4. The app runs fully without them. ─────────
# Without RESEND_API_KEY every outbound email is written to the in-app
# outbox instead of being sent, and is visible on screen.
RESEND_API_KEY=
EMAIL_FROM="IQ Sports Supply <orders@iqsportssupply.com>"

# Without these, Xero push is disabled and the Xero-format CSV export covers accounts.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/api/xero/callback
